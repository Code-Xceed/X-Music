{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "The ultimate native in-game music client for Minecraft. Seamlessly stream high-quality audio from YouTube, Spotify, and local files directly within your world.",
  "authors": $mod_authors,
    "contact": {
    "homepage": "https://modrinth.com/project/x-music",
    "sources": "https://github.com/Code-Xceed/X-Music-src",
    "issues": "https://github.com/Code-Xceed/X-Music-src/issues",
    "discord": "https://discord.com/users/1202625841675243524"
  },
  "license": "${license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.codexceed.xmusic.XMusicFabric"
    ]
  },
  "mixins": [
    "xmusic.mixins.json",
    "xmusic.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "fabric-api": "*",
    "minecraft": $compatible_mc_versions
  },
  "suggests": {
    "watermedia": "*"
  }
,
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.com/users/1202625841675243524"
      }
    }
  }
}